APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database — use MySQL or SQLite
# For SQLite (zero-config local dev): set DB_CONNECTION=sqlite
# For MySQL: fill in the values below
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policyflow
DB_USERNAME=your_username
DB_PASSWORD=your_password

# No external API keys required — mock insurer is built-in
# No Redis required — this is the minimal setup
